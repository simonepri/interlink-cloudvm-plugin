{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergePr",
    ":enablePreCommit"
  ],
  "platformAutomerge": true,
  "automergeStrategy": "squash",
  "labels": [
    "dependencies",
    "renovate"
  ],
  "packageRules": [
    {
      "description": "Auto-merge minor and patch updates when CI checks pass",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Never group major updates across any ecosystem",
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null,
      "labels": [
        "breaking-change",
        "major-bump"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "^mise\\.toml$"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>.*?)\\s+depName=(?<depName>.*?)(?:\\s+versioning=(?<versioning>.*?))?\\n.*?=\\s*\"?(?<currentValue>v?[0-9.]+)\"?"
      ]
    }
  ]
}
