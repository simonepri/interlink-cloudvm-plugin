{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergePr",
    ":enablePreCommit"
  ],
  "platformAutomerge": true,
  "automergeStrategy": "squash",
  "labels": [
    "dependencies",
    "renovate"
  ],
  "packageRules": [
    {
      "description": "Auto-merge minor and patch updates when CI checks pass",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Never group major updates across any ecosystem",
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null,
      "labels": [
        "breaking-change",
        "major-bump"
      ]
    },
    {
      "description": "Keep the CloudVM Karpenter controller on the Karpenter core release the target clusters run, with the Kubernetes libraries that release uses; bump them together with the clusters' Karpenter",
      "matchFileNames": [
        "src/karpenter/go.mod"
      ],
      "matchPackageNames": [
        "sigs.k8s.io/karpenter",
        "sigs.k8s.io/controller-runtime",
        "k8s.io/**"
      ],
      "enabled": false
    },
    {
      "description": "Never auto-merge a stargz snapshotter bump: CLOUDVM_STARGZ_SHA256 in the boot script and its tests must be updated to the new release tarball by hand",
      "matchPackageNames": [
        "containerd/stargz-snapshotter"
      ],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "^mise\\.toml$"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>.*?)\\s+depName=(?<depName>.*?)(?:\\s+versioning=(?<versioning>.*?))?\\n.*?=\\s*\"?(?<currentValue>v?[0-9.]+)\"?"
      ]
    },
    {
      "description": "Track the stargz snapshotter release the worker boot script installs",
      "customType": "regex",
      "fileMatch": [
        "^src/cloudvm/cloudinit\\.go$"
      ],
      "matchStrings": [
        "CLOUDVM_STARGZ_VERSION=\"(?<currentValue>[0-9.]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "containerd/stargz-snapshotter",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ]
}
